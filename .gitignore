node_modules/
dist/
dist-ssr/
.cache/
*.log
.impeccable/

# Local env - VITE_SITE_URL is deployment-specific. Commit .env.example only.
.env
.env.local
.env.*.local

# Lighthouse output is a transient measurement artifact (~1 MB).
# Committed audits would be stale the moment the code changes.
lighthouse_report.json
lighthouse-*.json

# OpenCode tooling is machine-local: the ponytail plugin and its slash
# commands install per developer and are not part of the site or its build.
# (.opencode/skills/ stays tracked - it is shared reference material.)
.opencode/command/
.opencode/plugins/

# Python bytecode caches. The skill scripts under .opencode/skills/ compile
# themselves on first run, and the three .pyc files that land in their
# __pycache__ were being committed - so every repo that ran them produced a diff
# containing nothing but regenerated binary.
__pycache__/
*.py[cod]

{
  "name": "default-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run build:client && npm run build:ssr && npm run build:prerender && npm run build:crawl",
    "build:client": "vite build && node scripts/save-template.mjs",
    "build:ssr": "vite build --ssr src/entry-server.jsx --outDir dist-ssr",
    "build:prerender": "node scripts/prerender.mjs",
    "build:crawl": "node scripts/crawl.mjs",
    "deploy:config": "node scripts/deploy-config.mjs",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "audit": "node scripts/audit.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "verify:seo": "node scripts/verify-seo.mjs",
    "verify:seo:strict": "node scripts/verify-seo.mjs --strict",
    "verify:build": "node scripts/verify-build.mjs",
    "images": "node scripts/images.mjs",
    "images:inspect": "node scripts/inspect-images.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.4",
    "vite": "^8.3.0"
  }
}
